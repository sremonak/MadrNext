{
  "name": "madrnext",
  "version": "1.0.0",
  "private": true,
  "description": "MadrNext — The Future of Madrasah Learning. Complete Dakhil & Alim course platform.",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src prisma tests --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "media:generate": "tsx scripts/generate-media.ts",
    "postinstall": "prisma generate --silent || true && bash scripts/dev/copy-pdf-worker.sh || true",
    "vendor:copy": "bash scripts/dev/copy-pdf-worker.sh",
    "audit:rehash": "tsx scripts/dev/rehash-audit.mts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "hls.js": "^1.7.4",
    "lucide-react": "^1.77.0",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}