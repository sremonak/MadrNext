# ─────────────────────────────────────────────────────────────────────────────
# MadrNext environment — COPY to `.env` and fill values. Never commit real
# secrets. Every value below is a placeholder with documentation.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (managed Postgres in production).
DATABASE_URL="postgresql://user:password@localhost:5432/madrnext"

# 64+ char secret used for HMAC signing (playback/document tokens, webhooks).
# Generate: openssl rand -hex 32
AUTH_SECRET="replace-with-random-hex-64"

# Short-lived signed media token lifetime (seconds).
MEDIA_TOKEN_TTL_SECONDS="120"

# Playback session limits per student.
MAX_CONCURRENT_PLAYBACKS="2"
MAX_CONCURRENT_SESSIONS="3"
SESSION_TTL_HOURS="72"

# Base URL (used in emails and absolute links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Email (SMTP). In dev, if unset, verification codes are written to the
#    server console instead of being sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="MadrNext <no-reply@madrnext.example>"

# ── SMS (informational provider; any provider with an HTTP API can be wired
#    into src/lib/notify.ts).
SMS_API_URL=""
SMS_API_KEY=""

# ── bKash (server-side credentials ONLY; the browser never sees these).
#    Sandbox creds are issued by bKash developer portal.
BKASH_APP_KEY=""
BKASH_APP_SECRET=""
BKASH_USERNAME=""
BKASH_PASSWORD=""
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

# ── Nagad
NAGAD_MERCHANT_ID=""
NAGAD_PRIVATE_KEY_PATH="" # PEM file mounted on the server
NAGAD_BASE_URL="https://sandbox.nagad.com.bd"

# ── SSLCommerz
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_BASE_URL="https://sandbox.sslcommerz.com"

# Webhook signing secrets (each gateway should be verified separately).
PAYMENT_WEBHOOK_SECRET_BKASH=""
PAYMENT_WEBHOOK_SECRET_NAGAD=""
PAYMENT_WEBHOOK_SECRET_SSLCOMMERZ=""

# ── File storage (development uses local disk; production examples below).
STORAGE_DIR="./storage"
# S3-compatible storage for production:
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
